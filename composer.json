{
    "name": "deinte/laravel-peppol",
    "description": "A Laravel package for PEPPOL electronic invoicing with support for multiple connectors",
    "keywords": [
        "deinte",
        "laravel",
        "peppol",
        "e-invoicing",
        "electronic-invoicing",
        "ubl"
    ],
    "homepage": "https://github.com/deinte/laravel-peppol",
    "license": "MIT",
    "authors": [
        {
            "name": "Dante Schrauwen",
            "email": "contact@danteschrauwen.be",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/deinte/scrada-php-sdk"
        }
    ],
    "require": {
        "php": "^8.5",
        "deinte/scrada-php-sdk": "^1.0",
        "illuminate/contracts": "^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "larastan/larastan": "^3.7",
        "laravel/pint": "^1.25",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.6||^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Deinte\\Peppol\\": "src/",
            "Deinte\\Peppol\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Deinte\\Peppol\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Deinte\\Peppol\\PeppolServiceProvider"
            ],
            "aliases": {
                "Peppol": "Deinte\\Peppol\\Facades\\Peppol"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
